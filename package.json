{
  "name": "service-business-platform",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "verticals/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @service-business/web dev",
    "build": "pnpm --filter @service-business/web build",
    "lint": "pnpm --filter @service-business/web lint",
    "typecheck": "pnpm --filter @service-business/web typecheck",
    "test": "tsx --test packages/platform/src/*.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
