{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "bun install",
  "buildCommand": "bun run --cwd apps/web build",
  "outputDirectory": "apps/web/.next",
  "crons": [
    {
      "path": "/api/cron/daily-intelligence",
      "schedule": "17 5 * * *"
    }
  ]
}
